PORT=5000

# Set to "production" on Render — enables stricter error handling and CORS
NODE_ENV=production

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/techstore?retryWrites=true&w=majority

# DNS override — set to your network's DNS server if Node fails to resolve Atlas SRV records.
# Leave blank when deploying to Render (cloud DNS works fine there).
# Example for corporate/university networks: MONGO_DNS=10.159.227.147
MONGO_DNS=

JWT_SECRET=replace_with_a_strong_random_string_32_chars_minimum
JWT_EXPIRE=30d

CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary — get these from cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Chapa Payment Gateway — get these from dashboard.chapa.co > Settings > API Keys
# Use CHASECK_TEST-... for sandbox testing, CHASECK-... for production
CHAPA_SECRET_KEY=CHASECK_TEST-your_test_secret_key_here
CHAPA_WEBHOOK_SECRET=your_webhook_secret_here

# Gmail SMTP — for transactional emails (order confirmation, payment, etc.)
# 1. Enable 2-Step Verification on your Gmail account
# 2. Go to Google Account > Security > App Passwords
# 3. Create an app password for "Mail" and paste it below (no spaces)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_16_char_app_password_here
